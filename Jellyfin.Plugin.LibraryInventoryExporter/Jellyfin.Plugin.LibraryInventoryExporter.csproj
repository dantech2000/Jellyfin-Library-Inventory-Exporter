<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <RootNamespace>Jellyfin.Plugin.LibraryInventoryExporter</RootNamespace>
    <AssemblyName>Jellyfin.Plugin.LibraryInventoryExporter</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(JellyfinAbiRevision)' != ''">
    <Version>$(PluginVersion).$(JellyfinAbiRevision)</Version>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Jellyfin.Controller" Version="$(JellyfinVersion)">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Jellyfin.Model" Version="$(JellyfinVersion)">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <None Remove="Configuration\configPage.html" />
    <None Remove="Configuration\configPage.js" />
    <EmbeddedResource Include="Configuration\configPage.html" />
    <EmbeddedResource Include="Configuration\configPage.js" />
    <None Include="..\assets\library-inventory-exporter.png" Link="library-inventory-exporter.png" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    meta.json is a template. Jellyfin trusts the guid, version and targetAbi in the packaged copy,
    so every target framework writes its own resolved meta.json next to the plugin DLL.
    The guid comes from build.yaml, which the plugin catalog manifest also reads.
  -->
  <Target Name="WritePluginMeta" AfterTargets="Build" Condition="'$(TargetFramework)' != ''">
    <PropertyGroup>
      <PluginGuid>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/../build.yaml')), '(?m)(?&lt;=^guid:\s*")[0-9a-fA-F-]{36}(?=")').Value)</PluginGuid>
    </PropertyGroup>
    <Error Condition="'$(PluginGuid)' == ''" Text="build.yaml has no guid: &quot;...&quot; line" />
    <PropertyGroup>
      <PluginMetaJson>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/meta.json').Replace('@PLUGIN_GUID@', '$(PluginGuid)').Replace('@PLUGIN_VERSION@', '$(Version)').Replace('@TARGET_ABI@', '$(JellyfinTargetAbi)').TrimEnd())</PluginMetaJson>
    </PropertyGroup>
    <WriteLinesToFile File="$(OutDir)meta.json" Lines="$([MSBuild]::Escape($(PluginMetaJson)))" Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>

  <Target Name="PublishPluginMeta" AfterTargets="Publish" Condition="'$(TargetFramework)' != ''">
    <Copy SourceFiles="$(OutDir)meta.json" DestinationFolder="$(PublishDir)" />
  </Target>
</Project>
